# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by the server-side Drizzle client.
# The docker-compose service below matches this default.
DATABASE_URL=postgresql://cognitivelab:cognitivelab@localhost:5433/cognitivelab

# --- API client (browser) ------------------------------------------------
# Same-origin route handlers. The leading empty string keeps requests on the
# current host so cookies and COOP/COEP isolation are preserved.
NEXT_PUBLIC_API_BASE_URL=

# Set to "false" to fall back to the in-browser localStorage mock store
# instead of the real database. Defaults to "false" (database-backed).
NEXT_PUBLIC_USE_MOCK_DATA=false
